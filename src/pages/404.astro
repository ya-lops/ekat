---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout>
  <div class="not-found">
    <div class="container">
      <div class="_inner">
        <div class="_code">404</div>
        <div class="text-center">
          <div class="font-24 font-bold">Упс! Страница не найдена.</div>
          <div class="font-18 font-light">
            Страница которую вы запросили отсутствует на сайте
          </div>
        </div>
        <a href="/" class="app-button accent">Перейти на главную</a>
      </div>
    </div>
  </div>
</BaseLayout>
