---
import ProductCard from "@/components/shared/ProductCard.astro";
import ProductCardMDX from "@/components/shared/ProductCardMDX.astro";
import CatalogView from "@/components/views/CatalogView.astro";
import { getCollection } from "astro:content";
const products = await getCollection("products");

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}
---

<CatalogView pageTitle="Каталог" bottomForm="getform" thisPage="catalog">
  <div class="product-list">
    {products.map((product) => <ProductCardMDX product={product} />)}
  </div>
</CatalogView>
