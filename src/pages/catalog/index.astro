---
import ProductCard from "@/components/shared/ProductCard.astro";
import CatalogView from "@/components/views/CatalogView.astro";
import products from "@/data/products";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}
---

<CatalogView pageTitle="Каталог" bottomForm="subscribe">
  <div class="product-list">
    {
      products.map((product) => (
        <ProductCard
          slug={product.slug}
          name={product.name}
          image={product.image}
          description={product.description}
        />
      ))
    }
  </div>
</CatalogView>

<style lang="scss" is:global>
  .product-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;
  }
</style>
