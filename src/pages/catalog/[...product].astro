---
import products from "@/data/products.js";
import ProductView from "@/components/views/ProductView.astro";

export async function getStaticPaths() {
  return products.map((product) => {
    return {
      params: { product: product.slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
---

<ProductView pageTitle={product.name} bottomForm="subscribe">
  <article class="product">
    <div class="_col">
      <section class="product-gallery">
        <div class="_main-image">
          <img src={product.image} alt={product.name} />
        </div>
        {
          product.imgs.map((i) => (
            <div class="_item">
              <img src={i.img} alt="" />
            </div>
          ))
        }
      </section>

      <!-- Блок про необходимость дизайна -->
      {
        product.needDesign && (
          <section class="product-notice">
            <p>Для данного типа упаковки необходимо разработать дизайн.</p>
            <p>
              Мы может разработать его по Вашим требованиям или использовать
              подготовленный Вами.
            </p>
            <p>
              Подробнее в нашей
              <a class="app-link" href="#linktoarticle">
                статье о разработке дизайна упаковки
              </a>
              .
            </p>
          </section>
        )
      }

      <!-- Блок с полезной статьей -->
      {
        product.article && (
          <section class="product-useful-article">
            <header>Полезная статья</header>
            <a href={product.article.href}>{product.article.title}</a>
            <div class="_image">
              <img src={product.article.img} alt="" />
            </div>
          </section>
        )
      }
    </div>

    <div class="_col">
      <section class="product-info">
        <header class="_header">
          <h1 class="_title">{product.name}</h1>
          <div class="_code">Артикул: {product.code}</div>
        </header>

        <div class="_actions">
          <button class="app-button ghost accent">Запросить цену</button>
          <button class="app-button ghost accent">Скачать спецификацию</button>
        </div>

        <!-- Блок характеристик, если указаны -->
        {
          product.specs && (
            <div class="product-specs">
              {product.specs.map((spec) => (
                <div class="_item">
                  <span class="_label">{spec.label}:</span>
                  <span class="_value">{spec.value}</span>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <section class="product-order">
        <button class="app-button accent">Заказать образцы</button>
      </section>

      <!-- Блок пропсов-иконок, если есть -->
      {
        product.props && (
          <section class="product-props">
            {product.props.map((prop) => (
              <div class="_item">
                <img src={prop.icon} title={prop.label} />
              </div>
            ))}
          </section>
        )
      }

      <!-- Блок логистики, если есть -->
      {
        product.logistics && (
          <section class="product-logistics">
            <div class="product-specs">
              <div class="_title">Логистика</div>
              {product.logistics.map((l) => (
                <div class="_item">
                  <span class="_label">{l.label}:</span>
                  <span class="_value">{l.value}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</ProductView>

<style lang="scss" is:global>
  .product {
    display: grid;
    grid-template-columns: 410px minmax(0, 1fr);
    align-items: start;
    column-gap: 52px;
    row-gap: 64px;

    ._col {
      display: grid;
      grid-template-columns: 100%;
      gap: 64px;

      &:nth-child(1) {
        position: sticky;
        top: 0;
      }
    }
  }

  .product-gallery {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;

    ._main-image {
      flex-basis: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      max-height: 320px;
      padding: 44px;
      background: rgba(0, 0, 0, 0.03);
      border-radius: 28px;
    }

    ._item {
      flex-basis: 30%;
      max-height: 100px;
      padding: 8px;
      background: rgba(0, 0, 0, 0.03);
      border-radius: 28px;
    }

    img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }
  }

  .product-notice {
    font-size: 14px;
    font-weight: 300;

    a {
      font-weight: bold;
    }

    p + p {
      margin-top: 1rem;
    }
  }

  .product-useful-article {
    display: flex;
    flex-flow: column;
    padding: 24px 44px 50px 44px;
    align-items: center;
    gap: 12px;
    border-radius: 44px;
    background: var(--ep-color-30);

    header {
      align-self: center;
      margin-bottom: 12px;
      padding: 2px 32px;
      border-radius: 44px;
      background-color: var(--ep-color-60);
      color: var(--ep-color-80);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 1.44px;
      text-transform: uppercase;
    }

    a {
      color: var(--ep-color-text-primary);
      font-size: 20px;
      font-weight: 500;
      text-decoration: none;

      &:hover {
        text-decoration: underline;
      }
    }

    ._image {
      border-radius: 28px;
      overflow: hidden;

      img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }
  }

  .product-info {
    display: grid;
    grid-template-columns: 100%;
    gap: 32px;

    // ._header {
    //   position: sticky;
    //   top: 0;
    //   z-index: 1;
    //   background: var(--ep-color-surface-0);
    // }

    ._title {
      font-size: 34px;
      font-weight: 700;
    }

    ._code {
      font-size: 18px;
      font-weight: 300;
    }

    ._actions {
      display: flex;
      gap: 18px;
    }
  }

  .product-order {
    justify-self: end;
  }

  .product-props {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;

    ._item {
      display: flex;
      align-items: center;
      justify-content: start;
      width: 94px;
      height: 94px;
      padding: 16px;
      border-radius: 28px;
      background-color: var(--ep-color-40);

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }
  }

  .product-specs {
    display: flex;
    flex-flow: column;
    gap: 8px;

    ._title {
      font-size: 24px;
      font-weight: 700;
    }

    ._item {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      font-size: 14px;
    }

    ._label {
      color: var(--ep-color-text-secondary);
    }

    ._value {
      color: var(--ep-color-accent-dark);
    }
  }
</style>
