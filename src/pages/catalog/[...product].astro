---
import products from "@/data/products.js";
import ProductView from "@/components/views/ProductView.astro";
import AddToFavorites from "@/components/shared/AddToFavorites.astro";

export async function getStaticPaths() {
  return products.map((product) => {
    return {
      params: { product: product.slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
---

<ProductView pageTitle={product.name} bottomForm="subscribe">
  <article class="product" x-data="product()">
    <div class="_col">
      <section class="product-gallery">
        <div class="_main-image">
          <AddToFavorites product={product} />

          <img src={product.image} alt={product.name} />
        </div>
        {
          product.imgs.map((i) => (
            <div class="_item">
              <img src={i.img} alt="" />
            </div>
          ))
        }
      </section>

      <!-- Блок про необходимость дизайна -->
      {
        product.needDesign && (
          <section class="product-notice">
            <p>Для данного типа упаковки необходимо разработать дизайн.</p>
            <p>
              Мы может разработать его по Вашим требованиям или использовать
              подготовленный Вами.
            </p>
            <p>
              Подробнее в нашей
              <a class="app-link" href="#linktoarticle">
                статье о разработке дизайна упаковки
              </a>
              .
            </p>
          </section>
        )
      }

      <!-- Блок с полезной статьей -->
      {
        product.article && (
          <section class="product-useful-article">
            <header>Полезная статья</header>
            <a href={product.article.href}>{product.article.title}</a>
            <div class="_image">
              <img src={product.article.img} alt="" />
            </div>
          </section>
        )
      }
    </div>

    <div class="_col">
      <section class="product-info">
        <header class="_header">
          <h1 class="_title">{product.name}</h1>
          <div class="_code">Артикул: {product.code}</div>
        </header>

        {
          product.description && (
            <p class="_description font-light">{product.description}</p>
          )
        }

        <div class="_actions">
          <button class="app-button ghost accent" x-on:click="requestCalcDialogOpen = true, btnLabel = 'Отправить', formTitle = 'Запросить цену'">Запросить цену</button>
          <button class="app-button ghost accent">Скачать спецификацию</button>
        </div>

        <!-- Блок характеристик, если указаны -->
        {
          product.specs && (
            <div class="product-specs">
              {product.specs.map((spec) => (
                <div class="_item">
                  <span class="_label">{spec.label}:</span>
                  <span class="_value">{spec.value}</span>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <section class="product-order">
        <button class="app-button accent" x-on:click="requestCalcDialogOpen = true, btnLabel = 'Заказать', formTitle = 'Заявка на образцы'">Заказать образцы</button>
      </section>

      <!-- Блок пропсов-иконок, если есть -->
      {
        product.props && (
          <section class="product-props">
            {product.props.map((prop) => (
              <div class="_item">
                <img src={prop.icon} title={prop.label} />
              </div>
            ))}
          </section>
        )
      }

      <!-- Блок логистики, если есть -->
      {
        product.logistics && (
          <section class="product-logistics">
            <div class="product-specs">
              <div class="_title">Логистика</div>
              {product.logistics.map((l) => (
                <div class="_item">
                  <span class="_label">{l.label}:</span>
                  <span class="_value">{l.value}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>
  </article>
</ProductView>
