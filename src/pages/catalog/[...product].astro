---
import products from "@/data/products.js";
import ProductView from "@/components/views/ProductView.astro";
import AddToFavorites from "@/components/shared/AddToFavorites.astro";

export async function getStaticPaths() {
  return products.map((product) => {
    return {
      params: { product: product.slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
---

<ProductView pageTitle={product.name} bottomForm="subscribe">
  <article class="product" x-data="product()">
    <div class="_col">
      <section class="product-gallery">
        <div class="_main-image">
          <AddToFavorites product={product} />

          <img src={product.image} alt={product.name} />
        </div>
        {
          product.imgs.map((i) => (
            <div class="_item">
              <img src={i.img} alt="" />
            </div>
          ))
        }
      </section>

      <!-- Блок про необходимость дизайна -->
      {
        product.needDesign && (
          <section class="product-notice">
            <p>Для данного типа упаковки необходимо разработать дизайн.</p>
            <p>
              Мы может разработать его по Вашим требованиям или использовать
              подготовленный Вами.
            </p>
            <p>
              Подробнее в нашей
              <a class="app-link" href="#linktoarticle">
                статье о разработке дизайна упаковки
              </a>
              .
            </p>
          </section>
        )
      }

      <!-- Блок с полезной статьей -->
      {
        product.article && (
          <section class="product-useful-article text-center">
            <header>Полезная статья</header>
            <a href={product.article.href}>{product.article.title}</a>
            <div class="_image">
              <img src={product.article.img} alt="" />
            </div>
          </section>
        )
      }
    </div>

    <div class="_col">
      <section class="product-info">
        <header class="_header">
          <h1 class="_title">{product.name}</h1>
          <div class="_code">Артикул: {product.code}</div>
        </header>

        {
          product.description && (
            <p class="_description font-light">{product.description}</p>
          )
        }

        <div class="_actions">
          <button
            class="app-button ghost accent"
            x-on:click="requestCalcDialogOpen = true, btnLabel = 'Отправить', formTitle = 'Запросить цену'"
            >Запросить цену</button
          >
          <button class="app-button ghost accent">Скачать спецификацию</button>
        </div>

        <!-- Блок характеристик, если указаны -->
        {
          product.specs && (
            <div class="product-specs">
              {product.specs.map((spec) => (
                <div class="_item">
                  <span class="_label">{spec.label}:</span>
                  <span class="_value">{spec.value}</span>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <section class="product-order">
        <button
          class="app-button accent"
          x-on:click="requestCalcDialogOpen = true, btnLabel = 'Заказать', formTitle = 'Заявка на образцы'"
          >Заказать образцы</button
        >
      </section>

      <!-- Блок пропсов-иконок, если есть -->
      {
        product.props && (
          <section class="product-props">
            {product.props.map((prop) => (
              <div class="_item">
                <img src={prop.icon} title={prop.label} />
              </div>
            ))}
          </section>
        )
      }

      <!-- Блок логистики, если есть -->
      {
        product.logistics && (
          <section class="product-logistics">
            <div class="product-specs">
              <div class="_title">Логистика</div>
              {product.logistics.map((l) => (
                <div class="_item">
                  <span class="_label">{l.label}:</span>
                  <span class="_value">{l.value}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div class="_full">
      <div class="product-description">
        <p>
          Пластиковые круглые банки серии «Шайба», изготавливаемые под крышку
          диаметром 120 мм, представлены в ассортименте компании «ЭлитУпаковка»
          следующими объемами: 150 мл, 160 мл, 200 мл, 450 мл и 600 мл.
          Пластиковая банка «Шайба» D120мм/200 мл производится из высокопрочного
          полипропилена и отличается небольшим весом (вес 1 банки приблизительно
          22 гр). Это бюджетный вариант качественной герметичной пластиковой
          упаковки, производимой по технологии тонкостенного литья.
        </p>
        <p>
          В соответствии с потребностями заказчика, банки могут быть как
          прозрачными, так и цветными, крышка может отличаться по цвету от
          корпуса банки. Способ декорации – самоклеящийся этикет, что
          значительно снижает затраты при заказе изготовления упаковки этого
          вида.
        </p>
        <p>
          Области применения: пищевая – пластиковая банка «Шайба» D120мм/200мл
          подходит для упаковки пресервов, икры, разносолов, меда, также может
          использоваться для порционной фасовки салатов для доставки еды или
          продаже в отделах готовой пищи в супермаркетах
        </p>
        <p>Преимущества:</p>
        <ul>
          <li>
            готовое решение в случае, если упаковка на объем 200 мл нужна в
            кратчайшие сроки;
          </li>
          <li>высокая степень герметичности;</li>
          <li>
            может быть выполнена в разных цветах либо материал может быть по
            умолчанию прозрачным;
          </li>
          <li>
            банки серии «Шайба» не деформируются при транспортировке, держат
            форму и стопируются за счет небольшого конуса в конструкции изделия,
            что значительно облегчает задачи логистики.
          </li>
        </ul>
      </div>
    </div>
  </article>
</ProductView>
