---
import { getCollection } from "astro:content";

import ProductView from "@/components/views/ProductView.astro";
import AddToFavorites from "@/components/shared/AddToFavorites.astro";
import Tag from "@/components/shared/Tag.astro";
import ImagePH from "@/components/shared/ImagePH.astro";

export async function getStaticPaths() {
  const products = await getCollection("products");

  return products.map((product) => {
    return {
      params: { product: product.slug },
      props: { product },
    };
  });
}

const { product } = Astro.props;
const { Content } = await product.render();
---

<ProductView pageTitle={product.data.name} bottomForm="subscribe">
  <article class="product" x-data="product()">
    <div class="_col">
      <div class="_sticky">
        <section class="product-gallery">
          <div
            class="_main-image"
            class:list={[!product.data.image && "has-no-image"]}
          >
            <AddToFavorites product={product} />

            {
              product.data.image && (
                <img src={product.data.image} alt={product.data.name} />
              )
            }

            {!product.data.image && <ImagePH />}
          </div>
          {
            product.data.imgs.map((i) => (
              <div class="_item">
                <img src={i.img} alt="" />
              </div>
            ))
          }
        </section>

        <!-- Блок про необходимость дизайна -->
        {
          product.data.needDesign && (
            <section class="product-notice">
              <p>Для данного типа упаковки необходимо разработать дизайн.</p>
              <p>
                Мы может разработать его по Вашим требованиям или использовать
                подготовленный Вами.
              </p>
              <p>
                Подробнее в нашей
                <a class="app-link" href="#linktoarticle">
                  статье о разработке дизайна упаковки
                </a>
                .
              </p>
            </section>
          )
        }

        <!-- Блок с полезной статьей -->
        {
          product.data.article && (
            <section class="product-useful-article text-center">
              <header>Полезная статья</header>
              <a href={product.data.article.href}>
                {product.data.article.title}
              </a>
              <div class="_image">
                <img src={product.data.article.img} alt="" />
              </div>
            </section>
          )
        }
      </div>
    </div>

    <div class="_col">
      <section class="product-info">
        <div class="_header">
          <h1 class="_title">{product.data.name}</h1>
          <div class="_code">Артикул: {product.data.code}</div>
          <div class="_props">
            {
              product.data.previewSpecs.map((l) => (
                <Tag>
                  <span class="font-medium" title={l.label}>
                    {l.label}: {l.value}
                  </span>
                </Tag>
              ))
            }
          </div>
        </div>

        {
          product.data.description && (
            <p class="_description font-light">{product.data.description}</p>
          )
        }

        <div class="_actions">
          <button
            class="app-button ghost accent"
            x-on:click="requestCalcDialogOpen = true, btnLabel = 'Отправить', formTitle = 'Запросить цену'"
            >Запросить цену</button
          >
          <button class="app-button ghost accent">Скачать спецификацию</button>
        </div>

        <!-- Блок характеристик, если указаны -->
        {
          product.data.specs && (
            <div class="product-specs">
              {product.data.specs.map((spec) => (
                <div class="_item">
                  <span class="_label">{spec.label}:</span>
                  <span class="_value">{spec.value}</span>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <section class="product-order">
        <button
          class="app-button accent"
          x-on:click="requestCalcDialogOpen = true, btnLabel = 'Заказать', formTitle = 'Заявка на образцы'"
          >Заказать образцы</button
        >
      </section>

      <!-- Блок пропсов-иконок, если есть -->
      {
        product.data.props && (
          <section class="product-props">
            {product.data.props.map((prop) => (
              <div class="_item">
                <img src={prop.icon} title={prop.label} />
              </div>
            ))}
          </section>
        )
      }

      <!-- Блок логистики, если есть -->
      {
        product.data.logistics && (
          <section class="product-logistics">
            <div class="product-specs">
              <div class="_title">Логистика</div>
              {product.data.logistics.map((l) => (
                <div class="_item">
                  <span class="_label">{l.label}:</span>
                  <span class="_value">{l.value}</span>
                </div>
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div class="_full">
      <div class="product-description app-general-content">
        <Content />
      </div>
    </div>
  </article>
</ProductView>
