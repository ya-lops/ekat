---
import IconHeart from "@/components/icons/IconHeart.astro";
import IconStar from "@/components/icons/IconStar.astro";
import ProductCard from "@/components/shared/ProductCard.astro";
import CatalogView from "@/components/views/CatalogView.astro";
import products from "@/data/products";

const empty = true;

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}
---

<CatalogView pageTitle="Избранное" bottomForm="getform" noFilter>
  <div class="favorites" x-data="{products: items}">
    <div class="product-list" x-show="products.length > 0" x-cloak>
      <template x-for="product in products">
        <div class="product-card">
          <div class="_wrap">
            <a class="_image fit-contain" :href={"/catalog/ + product.slug"}>
              <img :src="product.image" alt="" />
            </a>
          </div>
          <a
            class="_title"
            :href={"/catalog/ + product.slug"}
            x-text="product.name"></a>

          <div
            class="product-favorite is-fav"
            :data-slug="product.slug"
            @click=`toFav()`
          >
            <div class="_icon">
              <IconHeart />
            </div>
          </div>
        </div>
      </template>
    </div>

    <div class="empty-favorite" x-show="products.length < 1" x-cloak>
      <IconStar />
      <p class="fs-18 font-light">Вы еще не добавили ничего в Избранное</p>
      <a href="/catalog" class="app-link fs-18 font-bold">
        Перейти в каталог и выбрать
      </a>
    </div>
  </div>
</CatalogView>
