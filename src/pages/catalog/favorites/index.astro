---
import IconStar from "@/components/icons/IconStar.astro";
import ProductCard from "@/components/shared/ProductCard.astro";
import CatalogView from "@/components/views/CatalogView.astro";
import products from "@/data/products";

const empty = true;

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}
---

<CatalogView pageTitle="Избранное" bottomForm="getform" noFilter>
  <div class="product-list">
    {
      // Если в избранном чтото есть
      !empty &&
        products.map((product) => (
          <ProductCard
            slug={product.slug}
            name={product.name}
            image={product.image}
            description={product.description}
          />
        ))
    }

    {
      // Если в избранном чтото пусто
      empty && (
        <div class="empty-favorite">
          <IconStar />
          <p class="fs-18 font-light">Вы еще не добавили ничего в Избранное</p>
          <a href="/catalog" class="app-link fs-18 font-bold">
            Перейти в каталог и выбрать
          </a>
        </div>
      )
    }
  </div>
</CatalogView>

<style lang="scss" is:global>
  .product-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 32px;

    .empty-favorite {
      grid-column: 1/-1;
    }
  }

  .empty-favorite {
    display: flex;
    flex-flow: column;
    align-items: center;

    p {
      margin-block: 24px 2px;
    }

    a {
      margin-top: 8px;
    }
  }
</style>
