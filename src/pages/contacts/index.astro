---
import IconChevronDown from "@/components/icons/IconChevronDown.astro";
import IconLocation from "@/components/icons/IconLocation.astro";
import IconMail from "@/components/icons/IconMail.astro";
import IconPersona from "@/components/icons/IconPersona.astro";
import IconPhoneContact from "@/components/icons/IconPhoneContact.astro";
import ContactsView from "@/components/views/ContactsView.astro";
---

<ContactsView pageTitle="Контакты">
  <div class="contacts">
    <section class="contact-block">
      <input class="contact-block__switcher" type="checkbox" name="" id="block01" />
      <label class="contact-block__switcher-label" for="block01"
        ><span>Офис в москве</span>
        <div class="_icon"><IconChevronDown /></div></label
      >
      <div class="_wrap">
        <div class="contact-block__content">
          <div class="_info">
            <header>
              <h2 class="text-page-header">Офис в москве</h2>
            </header>
            <div class="contact-block__info-item">
              <div class="_icon"><IconLocation /></div>
              <div class="_label">Адрес</div>
              <div class="_value">г. Москва, ул. Сергея Эйзенштейна, 8с1, офис 323</div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconMail /></div>
              <div class="_label">Email</div>
              <div class="_value">
                <a href="mailto:sales@elitupakovka.ru">sales@elitupakovka.ru</a><br />
                <a href="mailto:elitplastm@gmail.com">elitplastm@gmail.com</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPhoneContact /></div>
              <div class="_label">Телефон / Факс</div>
              <div class="_value">
                <a href="tel:+74951081655">+7 495 108-16-55</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPersona /></div>
              <div class="_label">Дежурный менеджер</div>
              <div class="_value">
                <a href="tel:+79609500090">+7 960 950-00-90</a>
              </div>
            </div>
          </div>
          <div class="_map">
            <!-- TODO!!!! ЭТОТ КОД НУЖНО ЗАМЕНИТЬ ИЗ ДРУГОЙ УЧЕТНОЙ ЗАПИСИ ЯНДЕКС!!!! -->
            <iframe
              src="https://yandex.ru/map-widget/v1/?um=constructor%3Aca2d746e746530a49b1fcf8a9304f59d5919a612b36f546fb9def311030d3d1f&source=constructor"
              height="400"
              frameborder="0"></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-block">
      <input class="contact-block__switcher" type="checkbox" name="" id="block02" />
      <label class="contact-block__switcher-label" for="block02"
        ><span>Офис в Барнауле</span><div class="_icon"><IconChevronDown /></div></label
      >
      <div class="_wrap">
        <div class="contact-block__content">
          <div class="_info">
            <header>
              <h2 class="text-page-header">Производство</h2>
            </header>
            <div class="contact-block__info-item">
              <div class="_icon"><IconLocation /></div>
              <div class="_label">Адрес</div>
              <div class="_value">г. Барнаул, пр.Космонавтов, 14/9</div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconMail /></div>
              <div class="_label">Email</div>
              <div class="_value">
                <a href="mailto:sales@elitupakovka.ru">sales@elitupakovka.ru</a><br />
                <a href="mailto:elitplastm@gmail.com">elitplastm@gmail.com</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPhoneContact /></div>
              <div class="_label">Телефон / Факс</div>
              <div class="_value">
                <a href="tel:+73852201334">+7 3852 201-334</a><br />
                <a href="tel:+73852201335">+7 3852 201-335</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPersona /></div>
              <div class="_label">Дежурный менеджер</div>
              <div class="_value">
                <a href="tel:+79609500090">+7 960 950-00-90</a>
              </div>
            </div>
          </div>
          <div class="_map">
            <!-- TODO!!!! ЭТОТ КОД НУЖНО ЗАМЕНИТЬ ИЗ ДРУГОЙ УЧЕТНОЙ ЗАПИСИ ЯНДЕКС!!!! -->
            <iframe
              src="https://yandex.ru/map-widget/v1/?um=constructor%3Ae5bb54ca2855b66305dbe9f2095fe38d3348e25753e0fd84cbef49a25266194f&source=constructor"
              height="400"
              frameborder="0"></iframe>
          </div>
        </div>
      </div>
    </section>
  </div>
</ContactsView>

