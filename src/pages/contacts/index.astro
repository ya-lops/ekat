        <div class="contact-block__content">
          <div class="_info">
            <header>
              <h2 class="text-page-header">Офис в москве</h2>
            </header>
            <div class="contact-block__info-item">
              <div class="_icon"><IconLocation /></div>
              <div class="_label">Адрес</div>
              <div class="_value">
                г. Москва, ул. Сергея Эйзенштейна, 8с1, офис 323
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconMail /></div>
              <div class="_label">Email</div>
              <div class="_value">
                <a href="mailto:sales@elitupakovka.ru">sales@elitupakovka.ru</a
                ><br />
                <a href="mailto:elitplastm@gmail.com">elitplastm@gmail.com</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPhoneContact /></div>
              <div class="_label">Телефон / Факс</div>
              <div class="_value">
                <a href="tel:+74951081655">+7 495 108-16-55</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPersona /></div>
              <div class="_label">Дежурный менеджер</div>
              <div class="_value">
                <a href="tel:+79609500090">+7 960 950-00-90</a>
              </div>
            </div>
          </div>
          <div class="_map">
            <!-- TODO!!!! ЭТОТ КОД НУЖНО ЗАМЕНИТЬ ИЗ ДРУГОЙ УЧЕТНОЙ ЗАПИСИ ЯНДЕКС!!!! -->
            <iframe src="https://yandex.ru/map-widget/v1/?um=constructor%3Aca2d746e746530a49b1fcf8a9304f59d5919a612b36f546fb9def311030d3d1f&amp;source=constructor" height="400" frameborder="0"></iframe>
          </div>
        </div>
      </div>
    </section>

    <section class="contact-block">
      <label class="contact-block__switcher-label" for="block02"
        >Офис в Барнауле</label
      >
      <input
        class="contact-block__switcher"
        type="checkbox"
        name=""
        id="block02"
      />
      <div class="_wrap">
        <div class="contact-block__content">
          <div class="_info">
            <header>
              <h2 class="text-page-header">Производство</h2>
            </header>
            <div class="contact-block__info-item">
              <div class="_icon"><IconLocation /></div>
              <div class="_label">Адрес</div>
              <div class="_value">г. Барнаул, пр.Космонавтов, 14/9</div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconMail /></div>
              <div class="_label">Email</div>
              <div class="_value">
                <a href="mailto:sales@elitupakovka.ru">sales@elitupakovka.ru</a
                ><br />
                <a href="mailto:elitplastm@gmail.com">elitplastm@gmail.com</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPhoneContact /></div>
              <div class="_label">Телефон / Факс</div>
              <div class="_value">
                <a href="tel:+73852201334">+7 3852 201-334</a><br />
                <a href="tel:+73852201335">+7 3852 201-335</a>
              </div>
            </div>
            <div class="contact-block__info-item">
              <div class="_icon"><IconPersona /></div>
              <div class="_label">Дежурный менеджер</div>
              <div class="_value">
                <a href="tel:+79609500090">+7 960 950-00-90</a>
              </div>
            </div>
          </div>
          <div class="_map">
            <!-- TODO!!!! ЭТОТ КОД НУЖНО ЗАМЕНИТЬ ИЗ ДРУГОЙ УЧЕТНОЙ ЗАПИСИ ЯНДЕКС!!!! -->
            <iframe src="https://yandex.ru/map-widget/v1/?um=constructor%3Ae5bb54ca2855b66305dbe9f2095fe38d3348e25753e0fd84cbef49a25266194f&amp;source=constructor" height="400" frameborder="0"></iframe>
          </div>
        </div>
      </div>
    </section>
  </div>
</ContactsView>

<style lang="scss" is:global>
  .contacts {
    display: flex;
    flex-flow: column;
    gap: 16px;

    @media (width > 768px) {
      gap: 96px;
    }
  }

  .contact-block {
    ._wrap {
      display: none;

      @media (width > 768px) {
        display: block;
      }
    }

    &__switcher-label {
      display: flex;
      padding: 16px 24px;
      border-radius: 20px;
      background: var(--ep-color-30);
      color: var(--ep-color-accent-dark);
      font-weight: 700;
      user-select: none;
      cursor: pointer;

      @media (width > 768px) {
        display: none;
      }
    }

    &__switcher {
      display: none;
    }

    &__switcher:checked ~ ._wrap {
      display: block;
    }

    &__content {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "map" "info";
      column-gap: 64px;

      @media (width > 768px) {
        grid-template-columns: clamp(280px, 50%, 370px) 1fr;
        grid-template-areas: "info map";
      }

      @media (width < 768px) {
        padding-block: 24px;
      }
    }

    ._info {
      grid-area: info;

      header {
        margin-bottom: 24px;
      }
    }

    ._map {
      grid-area: map;

      iframe {
        width: 100%;
        max-width: 100%;
      }
    }

    &__info-item {
      display: grid;
      grid-template-columns: 48px 1fr;
      column-gap: 24px;
      font-size: 14px;

      & + & {
        margin-top: 16px;
      }

      > ._icon {
        grid-row: 1/3;
      }

      > ._label {
        font-weight: 700;
        line-height: 28px;
      }

      > ._value {
        line-height: 22px;

        a {
          text-decoration: none;
          color: var(--ep-color-text-primary);
        }
      }
    }
  }
</style>
