---
import "@/styles/index.scss";
import AppFooter from "@/components/AppFooter.astro";
import AppHeader from "@/components/AppHeader.astro";
import AppFooterScripts from "@/components/AppFooterScripts.astro";
import RequestCalcDialog from "@/components/dialogs/RequestCalcDialog.astro";
---

<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>ЭЛИТУПАКОВКА – только готовые решения</title>
  </head>
  <body
    class="app"
    x-data="{requestCalcDialogOpen: false, btnLabel: 'Заказать', formTitle: 'Заявка'}"
  >
    <AppHeader />

    <div class="app-content">
      <slot />
    </div>

    <AppFooter />

    <AppFooterScripts />

    <!-- Форма "Заявка на расчет" -->
    <RequestCalcDialog />
  </body>
</html>
