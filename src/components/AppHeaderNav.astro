---
import nav from "@/data/nav";
import IconHamburger from "@/components/icons/IconHamburger.astro";
---

<div class="app-header-nav" x-data="{headerNavOpened: false}" :class="{'is-opened' : headerNavOpened}">
  <div class="_hamburger" tabindex="-1" x-on:click="headerNavOpened = true">
    <IconHamburger />
  </div>
  <div class="_items" x-on:click.self="headerNavOpened = false">
    <div class="_items-inner" >
      <div class="_menu" tabindex="-1">
        {
          nav.map((menuitem) => (
            <div class="_item">
              <a href={menuitem.href}>{menuitem.label}</a>

              {menuitem.sublinks && (
                <div class="_submenu">
                  {menuitem.sublinks.map((subitem) => (
                    <div class="_subitem">
                      <a href={subitem.href}>{subitem.label}</a>
                    </div>
                  ))}
                </div>
              )}
            </div>
          ))
        }
      </div>

      <aside class="hide-on-pointer-fine">
        <div
          class="app-button ghost"
          x-on:click="requestCalcDialogOpen = true, headerNavOpened = false, btnLabel = 'Заказать', formTitle = 'Заявка на образцы'"
        >
          Оставить заявку
        </div>
      </aside>

      <aside class="_footnotes hide-on-pointer-fine">
        <div class="_copy">© 2024г. ООО «Элитпласт+»</div>
        <div class="_sidelinks">
          <a href="#agreement">Пользовательское соглашение ООО «Элитпласт+»</a>
          <a href="#personal1">Конфиденциальность персональной информации</a>
          <a href="#personal2">Политика в отношении персональных данных</a>
        </div>
      </aside>
    </div>
  </div>
</div>
