---
import nav from "@/data/nav";
---

<div class="app-header-nav">
  {
    nav.map((menuitem) => (
      <div class="_item">
        <a href={menuitem.href}>{menuitem.label}</a>

        {menuitem.sublinks && (
          <div class="_submenu">
            {menuitem.sublinks.map((subitem) => (
              <div class="_subitem">
                <a href={subitem.href}>{subitem.label}</a>
              </div>
            ))}
          </div>
        )}
      </div>
    ))
  }
</div>

<style lang="scss" is:global>
  .app-header-nav {
    display: flex;
    align-items: center;
    gap: 32px;

    ._item {
      position: relative;
      color: var(--ep-color-text-primary-inverse);
    }

    ._submenu {
      position: absolute;
      top: 100%;
      left: -18px;
      display: none;
      padding: 18px;
      border-radius: 10px;
      background: var(--ep-color-90);
    }

    ._item:hover ._submenu {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    ._subitem {
      width: max-content;
      font-size: 14px;
      font-weight: 400;
    }

    a {
      color: inherit;
      text-decoration: none;

      &:hover {
        color: var(--ep-color-accent);
      }
    }
  }
</style>
