---
import RequestCalcDialog from "../dialogs/RequestCalcDialog.astro";


---

<div class="iml-form-block">
  <div class="container">
    <div class="_inner">
      <div class="iml-form +tiny">
        <header class="_header">
          <h3 class="text-form-header">Остались вопросы по IML упаковке?</h3>
          <p class="text-form-subheader">Мы готовы ответить</p>
        </header>
        <div class="_body">
          <button class="app-button accent" x-on:click="requestCalcDialogOpen = true">Задать вопрос</button>
        </div>
      </div>
    </div>
  </div>
</div>
