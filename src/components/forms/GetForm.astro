---
import PreferredContacts from "../shared/PreferredContacts.astro";
---

<div class="get-form-block">
  <div class="container">
    <div class="_inner">
      <form action="" class="get-form">
        <header class="_header">
          <h3 class="text-form-header">Свяжитесь с нами</h3>
          <p class="text-form-subheader">
            Консультируем по любым вопросам про упаковку
          </p>
        </header>
        <div class="_body">
          <input type="text" placeholder="Ваше имя" required />
          <input type="text" placeholder="Телефон" required />
          <PreferredContacts />
        </div>
        <div class="_footer">
          <button class="app-button accent">Заказать образцы</button>
        </div>
      </form>
      <div class="_image">
        <picture>
          <source srcset="/images/cups.png" media="(min-width: 768px)" />
          <img src="/images/cup.png" alt="" loading="lazy" />
        </picture>
      </div>
    </div>
  </div>
</div>
