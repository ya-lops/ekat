---

---

<div class="subscribe-form-block">
  <div class="container">
    <div class="_inner">
      <form action="" class="subscribe-form">
        <header class="_header">
          <h3 class="text-form-header text-center">
            Хотите получать лучшие статьи от экспертов?
          </h3>
        </header>
        <div class="_body">
          <input type="text" placeholder="Ваше имя" required />
          <input type="text" placeholder="Email" required />
          <button class="app-button big accent">Подписаться</button>
        </div>
        <div class="_footer">
          <div>
            <input
              type="checkbox"
              name="subsribe"
              id="subsribeAgreement"
              required
            />
            <label for="subsribeAgreement"
              >Согласен на обработку персональных данных и рассылку статьей</label
            >
          </div>
        </div>
        <div class="_image">
          <picture>
            <source srcset="/images/fly-mail.png" media="(min-width: 768px)" />
            <img src="/images/fly-mail.png" alt="" />
          </picture>
        </div>
      </form>
    </div>
  </div>
</div>
