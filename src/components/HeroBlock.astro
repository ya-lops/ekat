---
import CompanyVideoDialog from "./dialogs/CompanyVideoDialog.astro";
import IconVideo from "./icons/IconVideo.astro";
---

<section class="hero-section" x-data="{companyVideoDialog: false}">
  <div class="container">
    <div class="_inner">
      <header class="_header">
        <h1>Только готовые решения</h1>
        <h2>Производим качественную<br />упаковку с 2001 года</h2>
      </header>

      <div class="_benefits">
        <div class="_benefits-item">
          <span class="font-34-fluid font-bold"
            >1<span class="font-light">+</span>
          </span>
          <span class="font-18-fluid">млрд единиц<br />упаковки выпущено</span>
        </div>
        <div class="_benefits-item">
          <span class="font-34-fluid font-bold"
            >100<span class="font-light">+</span></span
          >
          <span class="font-18-fluid">сотрудников<br />на производстве</span>
        </div>
        <div class="_benefits-item">
          <span class="font-34-fluid font-bold"
            >20<span class="font-light">+</span></span
          >
          <span class="font-18-fluid">лет производим<br />упаковку</span>
        </div>
        <div class="_benefits-item">
          <span class="font-34-fluid font-bold"
            >10<span class="font-light">+</span></span
          >
          <span class="font-18-fluid">тонн переработки<br />пластика в месяц</span>
        </div>
      </div>

      <div class="_actions">
        <button class="app-button ghost" x-on:click="companyVideoDialog = true">
          <IconVideo />
          <span>О производстве</span>
        </button>
        <a class="app-button ghost" href="/about">История компании</a>
      </div>

      <CompanyVideoDialog />
    </div>
  </div>
</section>
