---
import nav from "@/data/nav";
---

<div class="app-footer-nav">
  <div class="_items">
    {
      nav.map((menuitem) => (
        <div class="_item">
          <a href={menuitem.href}>{menuitem.label}</a>

          {menuitem.sublinks && (
            <div class="_submenu">
              {menuitem.sublinks.map((subitem) => (
                <div class="_subitem">
                  <a href={subitem.href}>{subitem.label}</a>
                </div>
              ))}
            </div>
          )}
        </div>
      ))
    }
  </div>
</div>
