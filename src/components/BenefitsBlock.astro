<style lang="scss" is:global>
.benefits-section {
  background: var(--ep-color-surface-1);

  ._header {
    margin-bottom: 64px;
  }

  ._inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 24px;
  }
}

.benefits-card {
  display: grid;
  grid-template-rows: max-content auto;
  gap: 12px;
  padding-inline: 12px;
  padding-bottom: 32px;
  border-radius: 44px;
  background: var(--ep-color-40);
  text-align: center;

  img {
    max-width: 100%;
    aspect-ratio: 1;
  }

  p {
    padding-inline: 12px;
    font-size: 20px;
    font-weight: 300;
  }
}
</style>
