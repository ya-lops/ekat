---
import blog from "@/data/blog";
import BlogCard from "./shared/BlogCard.astro";
---

<section class="app-section cases-section">
  <div class="container">
    <header class="_header app-page-header">
      <h2>Наши кейсы</h2>
    </header>
    <div class="_inner">
      {blog.map((item) => <BlogCard data={item} />)}
    </div>
    <div class="_action">
      <a href="/blog" class="app-button accent">Все кейсы</a>
    </div>
  </div>
</section>

<style lang="scss" is:global>
  .cases-section {
    ._header {
      margin-bottom: 64px;
    }

    ._inner {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 32px;
    }

    ._action {
      display: flex;
      justify-content: center;
      margin-top: 64px;
    }
  }
</style>
