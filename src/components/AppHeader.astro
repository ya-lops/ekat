---
import AppHeaderNav from "./AppHeaderNav.astro";


---

<header class="app-header">
  <div class="container">
    <div class="_inner">
      <a class="app-header__logo" href="/" rel="nofollow">
        <img src="/images/app-logo.svg" alt="" />
      </a>

      <AppHeaderNav/>

      <div class="app-header__actions">
        <a href="/favorites">FAV</a>
      </div>
    </div>
  </div>
</header>

<style lang="scss" is:global>
  .app-header {
    background: var(--ep-color-90);

    ._inner {
      display: flex;
      align-items: center;
      gap: 54px;
      padding-block: 18px;
    }

    &__logo {
      img {
        max-width: 163px;
      }
    }

    &__actions {
      margin-left: auto;
    }
  }

  
</style>
