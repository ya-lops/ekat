---
import AppHeaderNav from "./AppHeaderNav.astro";
import IconHeart from "./icons/IconHeart.astro";
---

<header class="app-header">
  <div class="container">
    <div class="_inner">
      <a class="_logo" href="/" rel="nofollow">
        <img src="/images/app-logo.svg" alt="" />
      </a>

      <div class="_nav">
        <AppHeaderNav />
      </div>

      <div class="_actions">
        <a href="/catalog/favorites" data-fav-count="27">
          <IconHeart/>
        </a>
      </div>
    </div>
  </div>
</header>
