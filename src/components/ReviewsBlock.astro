---
import reviews from "@/data/reviews";
import ReviewCard from "./shared/ReviewCard.astro";
---

<section class="app-section reviews-section">
  <div class="container">
    <header class="_header app-page-header">
      <h2>За что нас ценят</h2>
    </header>
    <div class="_inner">
      <!-- Берем из данных последние 3 -->
      {reviews.slice(Math.max(reviews.length - 3, 0)).map((review) => <ReviewCard data={review} />)}
      <!-- Слайдер с отзывами, но пока листингом -->
    </div>
  </div>
</section>

<style lang="scss" is:global>
  .reviews-section {
    ._header {
      margin-bottom: 64px;
    }

    ._inner {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      align-items: center;
      gap: 32px;
    }
  }
</style>
