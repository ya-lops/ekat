---
const shortcutsData = [
  { icon: "ice-cream.svg", name: "Мороженое", href: "#linkto" },
  { icon: "cheese.svg", name: "Сыры", href: "#linkto" },
  { icon: "oil.svg", name: "Масло", href: "#linkto" },
  { icon: "honey.svg", name: "Мед", href: "#linkto" },
  { icon: "deserts.svg", name: "Десерты", href: "#linkto" },
  { icon: "milk.svg", name: "Молочные продукты", href: "#linkto" },
  { icon: "spices.svg", name: "Специи", href: "#linkto" },
  { icon: "chemistry.svg", name: "Бытовая химия", href: "#linkto" },
  { icon: "cosmetics.svg", name: "Косметика", href: "#linkto" },
  { icon: "fasteners.svg", name: "Крепежные изделия", href: "#linkto" },
  { icon: "other.svg", name: "Строительные смеси", href: "#linkto" },
  { icon: "zoo.svg", name: "Зоотовары", href: "#linkto" },
  { icon: "plants.svg", name: "Подкормки для растений", href: "#linkto" },
  { icon: "handmade.svg", name: "Товары для рукоделия", href: "#linkto" },
  { icon: "other.svg", name: "Другое", href: "#linkto" },
];
---

<section class="app-section catalog-shortcuts-section">
  <div class="container">
    <header class="_header app-page-header">
      <h2>Упаковка для продукции</h2>
    </header>
    <div class="_inner">
      {
        shortcutsData.map((item) => (
          <a href={item.href} class="catalog-shortcut">
            <img src={"/images/categories/" + item.icon} alt="" />
            <span>{item.name}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss" is:global>
  .catalog-shortcuts-section {
    ._header {
      margin-bottom: 64px;
    }

    ._inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 24px;
    }
  }

  .catalog-shortcut {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    max-width: 190px;
    padding: 12px 24px;
    border-radius: 12px;
    background: var(--ep-color-surface-1);
    text-decoration: none;
    color: var(--ep-color-text-primary);

    &:hover {
      background: var(--ep-color-40);
    }

    img {
      width: auto;
      max-height: 44px;
    }

    span {
      font-size: 14px;
      font-weight: 300;
    }
  }
</style>
