---
import IconWrite from "../icons/IconWrite.astro";
import IconPhone from "../icons/IconPhone.astro";
import IconTelegram from "../icons/IconTelegram.astro";
import IconWhatsapp from "../icons/IconWhatsapp.astro";
---

<div
  class="app-dialog js-getPriceDialog"
  :class="{'is-shown' : getPriceDialogOpen}"
  x-show="getPriceDialogOpen"
  x-on:click.outside="getPriceDialogOpen = false"
>
  <div class="app-dialog__body">
    <div class="get-price-dialog">
      <div class="_title">
        Точная цена будет определена после расчета конструктора
      </div>
      <button
        class="app-button accent"
        x-on:click="getPriceDialogOpen = false, requestCalcDialogOpen = true"
      >
        <IconWrite />
        <span>Заявка на расчет</span>
      </button>
      <div class="_contacts">
        <a href="tel:+79039310365">
          <IconPhone />
          <span>+7 (903) 931-03-65</span>
        </a>
        <a href="#whatsapp">
          <IconWhatsapp />
          <span>Написать в WhatsApp</span>
        </a>
        <a href="#telegram">
          <IconTelegram />
          <span>Написать в Telegram</span>
        </a>
      </div>
    </div>
  </div>
</div>
