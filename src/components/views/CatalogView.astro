---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";
import CatalogFilter from "../shared/CatalogFilter.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
  thisPage?: string;
  noFilter?: boolean;
}

const { pageTitle, bottomForm, noFilter = false, thisPage } = Astro.props;
---

<BaseLayout>
  <div class="catalog-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <div class="_item"><a href="/">Главная</a></div>
        {
          thisPage == "catalog" && (
          <div class="_item"><span>Каталог</span></div>
          )
        }
        
        {
          thisPage !== "catalog" && (
            <div class="_item">
              <a href="/catalog">Каталог</a>
            </div>
            <div class="_item"><span>{pageTitle}</span></div>
          )
        }
      </ul>
      <article class:list={["catalog-page"]}>
        <header>
          <h1 class="text-page-header text-center">{pageTitle}</h1>
        </header>
          <!-- Пока убираю недоделанный фильтр -->
          <!-- Нужно понять как он будет функционировать -->
        <div style="display: none;">
          {
            !noFilter && <CatalogFilter/>
          }
        </div>
        <slot />
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>

<style lang="scss" is:global>
  .catalog-page {
    display: grid;
    grid-template-columns: 100%;
    gap: 64px;
  }
</style>
