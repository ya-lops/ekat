---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}

const { pageTitle, bottomForm } = Astro.props;
---

<BaseLayout>
  <div class="catalog-view app-view">
    <div class="container">
      <article class:list={["catalog-page"]}>
        <header>
          <h1 class="text-page-header text-center">{pageTitle}</h1>
        </header>
        <slot />
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>

<style lang="scss" is:global>
  .catalog-page {
    display: grid;
    grid-template-columns: 100%;
    gap: 64px;
  }
</style>
