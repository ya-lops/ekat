---
import products from "@/data/products";

import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";
import Section from "../shared/Section.astro";
import ProductCard from "@/components/shared/ProductCard.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
  thisPage?: string;
}

const { pageTitle, bottomForm } = Astro.props;
---
<BaseLayout>
  <div class="product-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <li class="_item"><a href="/">Главная</a></li>
        <li class="_item">
          <a href="/catalog">Каталог</a>
        </li>
        <li class="_item"><span>{pageTitle}</span></li>
      </ul>

      <slot />
    </div>
  </div>

  <!-- Здесь мы должны фильтрануть по типу товара. -->
  <!-- Сейчас показываем только 3 -->
  <Section
    title="Похожие товары"
    actionHref="/catalog"
    actionLabel="Смотреть все"
  >
    <div class="catalog-block">
      {
        products
          .slice(0, 3)
          .map((product) => (
            <ProductCard
              product={product}
            />
          ))
      }
    </div>
  </Section>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>
