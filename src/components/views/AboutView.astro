---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";

interface Props {
  pageTitle: string;
  floatSide?: boolean;
  blogpost?: boolean;
  bottomForm?: "subscribe" | "getform";
  thisPage?: string;
}

const {
  pageTitle,
  floatSide = false,
  bottomForm,
  blogpost = false,
  thisPage
} = Astro.props;
---

<BaseLayout>
  <div class="about-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <li class="_item"><a href="/">Главная</a></li>
        {
          thisPage == "about" && (
          <li class="_item"><span>О компании</span></li>
          )
        }
        
        {
          thisPage !== "about" && (
            <li class="_item">
              <a href="/about">О компании</a>
            </li>
            <li class="_item"><span>{pageTitle}</span></li>
          )
        }
      </ul>

      <article
        class:list={[
          "about-page",
          floatSide ? "has-float-side" : "",
          blogpost ? "as-blogpost" : "",
        ]}
      >
        <div class="_content">
          <header>
            <h1 class="text-page-header text-center">{pageTitle}</h1>
          </header>
          <slot />
        </div>

        {
          floatSide && (
            <aside class="_float-side">
              <slot name="floatSide" />
            </aside>
          )
        }
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>
