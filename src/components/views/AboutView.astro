---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";

interface Props {
  pageTitle: string;
  floatSide?: boolean;
  bottomForm?: "subscribe" | "getform";
}

const { pageTitle, floatSide = false, bottomForm } = Astro.props;
---

<BaseLayout>
  <div class="about-view">
    <div class="container">
      <article class:list={["about-page", floatSide ? "has-float-side" : ""]}>
        <div class="_content">
          <header>
            <h1 class="app-page-header">{pageTitle}</h1>
          </header>
          <slot />
        </div>

        {
          floatSide && (
            <aside class="_float-side">
              <slot name="floatSide" />
            </aside>
          )
        }
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>
 
<style lang="scss" is:global>
  .about-page {
    display: grid;
    grid-template-columns: 100%;
    align-items: start;
    gap: 18px;
    padding-block: 52px;

    &.has-float-side {
      grid-template-columns: minmax(0, 1fr) 320px;
    }

    ._float-side {
      position: sticky;
      top: 56px;
    }

    header {
      margin-bottom: 32px;
    }

    header + h2 {
      margin-top: 0;
    }

    h2 {
      font-size: 28px;
      font-weight: 500;
      margin-block: 32px 24px;
    }

    p,
    li {
      margin-bottom: 24px;
      font-size: 18px;
      line-height: 1.66;
      font-weight: 300;
    }

    ul {
      list-style-position: inside;

      li {
        margin-bottom: 24px;

        &::marker {
          color: var(--ep-color-70);
        }
      }
    }
  }
</style>
