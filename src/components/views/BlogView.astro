---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";
import IMLForm from "../forms/IMLForm.astro";
import IMLFormTiny from "../forms/IMLFormTiny.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform" | "iml" | "iml-tiny";
  thisPage: string;
  pageType?: 'blogpost';
}

const { pageTitle, bottomForm, thisPage, pageType } = Astro.props;
---

<BaseLayout>
  <div class="blog-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <li class="_item"><a href="/">Главная</a></li>
        {
          thisPage == "blog" && (
          <li class="_item"><span>Блог</span></li>
          )
        }
        
        {
          thisPage !== "blog" && (
            <li class="_item">
              <a href="/blog">Блог</a>
            </li>
            <li class="_item"><span>{pageTitle}</span></li>
          )
        }
      </ul>

      <article class:list={["blog-page"]}>
        <header>
          <h1 class:list={['text-page-header', pageType == 'blogpost' ? 'text-left' : 'text-center']}>{pageTitle}</h1>
        </header>

        { 
          pageType !== 'blogpost' && (
            <div class="_blog-links">
              <a href="/blog/news" class:list={[thisPage == 'news' ? 'is-current' : '']}>Новости</a>
              <a href="/blog/cases" class:list={[thisPage == 'cases' ? 'is-current' : '']}>Кейсы</a>
              <a href="/blog/articles" class:list={[thisPage == 'articles' ? 'is-current' : '']}>Статьи</a>
            </div>
          )
        }
        
        <slot />

        <div class="_action-btn">
          <button class="app-button accent light">Загрузить еще</button>
        </div>
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
  {bottomForm == "iml" && <IMLForm/>}
  {bottomForm == "iml-tiny" && <IMLFormTiny/>}
</BaseLayout>
