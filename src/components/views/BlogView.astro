---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
}

const { pageTitle, bottomForm } = Astro.props;
---

<BaseLayout>
  <div class="blog-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <div class="_item"><a href="/">Главная</a></div>
        {
          Astro.request.url.split("/").pop() !== "blog" && (
            <div class="_item">
              <a href="/blog">Блог</a>
            </div>
          )
        }
        <div class="_item"><span>{pageTitle}</span></div>
      </ul>

      <article class:list={["blog-page"]}>
        <header>
          <h1 class="text-page-header text-center">{pageTitle}</h1>
        </header>
        <div class="_blog-links">
          <a href="/blog/news" class:list={[Astro.request.url.split("/").pop() == "news" ? 'is-current' : '']}>Новости</a>
          <a href="/blog/cases" class:list={[Astro.request.url.split("/").pop() == "cases" ? 'is-current' : '']}>Кейсы</a>
          <a href="/blog/articles" class:list={[Astro.request.url.split("/").pop() == "articles" ? 'is-current' : '']}>Статьи</a>
        </div>
        <slot />
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>

<style lang="scss" is:global>
  // _blog.scss
</style>
