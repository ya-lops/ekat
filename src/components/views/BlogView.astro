---
import BaseLayout from "@/layouts/BaseLayout.astro";
import GetForm from "../forms/GetForm.astro";
import SubscribeForm from "../forms/SubscribeForm.astro";

interface Props {
  pageTitle: string;
  bottomForm?: "subscribe" | "getform";
  thisPage: string;
}

const currentPage = Astro.request.url.split("/").pop();

const { pageTitle, bottomForm, thisPage } = Astro.props;
---

<BaseLayout>
  <div class="blog-view app-view">
    <div class="container">
      <ul class="app-breadcrumbs">
        <div class="_item"><a href="/">Главная</a></div>
        {
          currentPage == "blog" && (
          <div class="_item"><span>Блог</span></div>
          )
        }
        
        {
          currentPage !== "blog" && (
            <div class="_item">
              <a href="/blog">Блог</a>
            </div>
            <div class="_item"><span>{pageTitle}</span></div>
          )
        }
      </ul>

      <article class:list={["blog-page"]}>
        <header>
          <h1 class="text-page-header text-center">{pageTitle}</h1>
        </header>
        <div class="_blog-links">
          <a href="/blog/news" class:list={[thisPage == 'news' ? 'is-current' : '']}>Новости</a>
          <a href="/blog/cases" class:list={[thisPage == 'cases' ? 'is-current' : '']}>Кейсы</a>
          <a href="/blog/articles" class:list={[thisPage == 'articles' ? 'is-current' : '']}>Статьи</a>
        </div>
        <slot />
      </article>
    </div>
  </div>

  {bottomForm == "getform" && <GetForm />}
  {bottomForm == "subscribe" && <SubscribeForm />}
</BaseLayout>
