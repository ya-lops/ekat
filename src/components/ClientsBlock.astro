---
const clientsData = [
  { logo: "br.png", name: "Baskin Robbins", href: "#linkto" },
  { logo: "rus-holod.png", name: "Русский Холодъ", href: "#linkto" },
  { logo: "icecake.png", name: "Icecake Moscow", href: "#linkto" },
  { logo: "mm.png", name: "MilkyMoon's", href: "#linkto" },
  { logo: "alterwest.png", name: "АльтерВест", href: "#linkto" },
  { logo: "snow-city.png", name: "Снежный городок", href: "#linkto" },
  { logo: "rotfront.png", name: "РотФронт", href: "#linkto" },
  { logo: "33p.png", name: "33пингвина", href: "#linkto" },
  { logo: "tutto.png", name: "Tutto Bene", href: "#linkto" },
];
---

<section class="app-section clients-shortcuts-section">
  <div class="container">
    <header class="_header app-page-header">
      <h2>Наши клиенты</h2>
    </header>
    <div class="_inner">
      {
        clientsData.map((item) => (
          <a href={item.href} class="client-shortcut">
            <img src={"/images/logos/" + item.logo} title={item.name} alt=""/>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style lang="scss" is:global>
  .clients-shortcuts-section {
    background: var(--ep-color-surface-1);

    ._header {
      margin-bottom: 64px;
    }

    ._inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 24px 64px;
    }
  }

  .client-shortcut {
    display: inline-flex;
    text-decoration: none;

    &:hover {
      scale: 1.05;
    }
  }
</style>
