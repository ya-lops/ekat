---
import ImagePH from "./ImagePH.astro";

const { photos } = Astro.props;
---

<div class:list={["product-photos", photos.length < 1 ? "has-no-image" : ""]}>
  {
    photos.length > 0 && (
      <div class="_pri js-product-photos-big" id="lightgallery">
        {photos.map((photo) => (
          <div class="_photo" data-src={photo.img}>
            <img src={photo.img} alt="" />
          </div>
        ))}
      </div>
    )
  }

  {
    photos.length > 1 && (
      <div class="_sec js-product-photos-small">
        {photos.map((photo) => (
          <div class="_photo">
            <img src={photo.img} alt="" />
          </div>
        ))}
      </div>
    )
  }

  {photos.length < 1 && <ImagePH />}
</div>

<style lang="scss" is:global>
  .product-photos {
    ._photo {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: var(--ep-spacer-32);
      background: rgba(0, 0, 0, 0.03);
      border-radius: var(--ep-radius-44-fluid);

      img {
        max-height: 256px;
      }
    }

    ._sec ._photo {
      padding: 8px;
      border-radius: var(--ep-radius-24-fluid);
    }

    &.has-no-image {
      aspect-ratio: 1.5;

      .image-ph {
        filter: brightness(0.5);
      }
    }

    ._sec {
      display: flex;
      gap: 8px;
      margin-top: var(--ep-spacer-16);

      @media (width < 769px) {
        display: none;
      }

      ._photo.slick-current {
        outline: 1px solid var(--ep-color-60);
        outline-offset: -3px;
      }
    }

    .slick-track {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .slick-arrow {
      background: rgba(0, 0, 0, 0.25);
      border-radius: 50%;
      z-index: 2;

      &::before {
        font-size: 14px;
      }

      &.slick-disabled {
        &::before {
          opacity: 1;
        }
      }

      &.slick-next {
        right: -20px;
      }

      &.slick-prev {
        left: -20px;
      }
    }

    .slick-dots li {
      margin: 0;
      scale: 5;
      pointer-events: none;

      &::before {
        color: var(--ep-color-90);
      }
    }
  }
</style>
