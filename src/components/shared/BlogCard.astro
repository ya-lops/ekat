---
import Tag from "./Tag.astro";

const { data } = Astro.props;
const blogHref = "/blog/";
---

<article class="blog-card">
  <a class="blog-card__image image-wrap fit-cover" href={blogHref + data.group + "/" + data.slug}>
    <img src={data.image} alt="" />
  </a>
  <div class="blog-card__content">
    <aside class="_meta">
      <Tag>{data.groupLabel}</Tag>
      <div class="font-12">{data.date}</div>
    </aside>
    <header class="_title font-bold">
      <h2>
        <a class="font-20-fluid" href={blogHref + data.group + "/" + data.slug}
          >{data.title}</a>
      </h2>
    </header>
    <p class="_description font-14-fluid font-light">
      {data.description}
    </p>
  </div>
</article>
