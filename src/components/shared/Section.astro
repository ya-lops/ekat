---
interface Props {
  title?: string;
  actionHref?: string;
  actionLabel?: string;
  darkBg?: boolean;
}

const { title, actionHref, actionLabel, darkBg = false } = Astro.props;
---

<section class:list={["app-section", darkBg ? 'has-dark-bg':'']}>
  <div class="container">
    <header class="_header text-page-header text-center">
      <h2>{title}</h2>
    </header>
    <slot />
    {
      actionHref && actionLabel && (
        <div class="_action">
          <a href={actionHref} class="app-button accent">
            {actionLabel}
          </a>
        </div>
      )
    }
  </div>
</section>
