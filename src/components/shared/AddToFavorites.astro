---
import IconHeart from "@/components/icons/IconHeart.astro";

const { product } = Astro.props;
---

<div
  class="product-favorite"
  :class="{'is-fav' : inFav}"
  data-slug={product.slug}
  data-name={product.data.name}
  data-image={product.data.image}
  x-data="product()"
  @click=`toFav()`
>
  <div class="_text">В избранное</div>
  <div class="_icon">
    <IconHeart />
  </div>
</div>
