---
import IconCross from "../icons/IconCross.astro";
import IconPhone from "../icons/IconPhone.astro";
import IconSupport from "../icons/IconSupport.astro";
import IconTelegram from "../icons/IconTelegram.astro";
import IconWhatsapp from "../icons/IconWhatsapp.astro";
---

<div class="app-contacts-btn" x-data="{contactsOpen: false}">
  <div class="_trigger" x-on:click.outside="contactsOpen = false">
    <template x-if="!contactsOpen">
      <div class="_btn _open" x-on:click="contactsOpen = true">
        <IconSupport />
      </div>
    </template>
    <template x-if="contactsOpen">
      <div class="_btn _close" x-on:click="contactsOpen = false">
        <IconCross />
      </div>
    </template>
    <div class="_menu" :class="{'is-opened': contactsOpen }">
      <div class="_c" style="--_i: 1">
        <a href="#tel" class="_btn _call">
          <IconPhone />
        </a>
      </div>
      <div class="_c" style="--_i: 2">
        <a href="#tel" class="_btn _whatsapp">
          <IconWhatsapp />
        </a>
      </div>
      <div class="_c" style="--_i: 3">
        <a href="#tel" class="_btn _telegram">
          <IconTelegram />
        </a>
      </div>
    </div>
  </div>
</div>
