---
import AddToFavorites from "./AddToFavorites.astro";
import ImagePH from "./ImagePH.astro";
import Tag from "./Tag.astro";

const { product } = Astro.props;
---

<div class="product-card">
  <div class="_wrap">
    <a class="_image fit-contain" href={"/catalog/" + product.slug}>
      {product.image && <img src={product.image} alt="" />}
      {!product.image && <ImagePH/>}
    </a>

    <div class="_props">
      {
        product.previewSpecs.map((l) => (
          <Tag>
            <span class="font-medium" title={l.label}>
              {l.value}
            </span>
          </Tag>
        ))
      }
    </div>
  </div>

  <a class="_title" href={"/catalog/" + product.slug}>
    {product.name}
  </a>

  {product.description && <div class="_description">{product.description}</div>}

  <AddToFavorites product={product} />
</div>
