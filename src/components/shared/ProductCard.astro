---
const { slug, name, favorite, image, props, description } = Astro.props;
---

<div class="product-card">
  <div class="_image">
    <img src={image} alt="" />
  </div>
  <a class="_title" href={'/catalog/'+slug}>
    {name}
  </a>
  <div class="_description">
    {description}
  </div>
</div>

<style lang="scss" is:global>
  .product-card {
    display: flex;
    flex-flow: column;
    gap: 12px;
    padding: 26px;
    padding-top: 32px;
    border-radius: 44px;
    background: var(--ep-color-80);

    ._image {
      max-height: 200px;
      aspect-ratio: 1;

      img {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
    }

    ._title {
      color: var(--ep-color-text-primary-inverse);
      font-size: 20px;
      font-weight: 700;
      text-align: center;
    }

    ._description {
      display: -webkit-box;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
      overflow: hidden;
      font-size: 12px;
    }
  }
</style>
