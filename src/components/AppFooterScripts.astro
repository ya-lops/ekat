<script defer src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
></script>
<script
  is:inline
  src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.min.js"
></script>
<script is:inline src="/scripts/jquery.selectric.min.js"></script>
<script is:inline src="/scripts/lightgallery.min.js"></script>

<script is:inline>
  // https://selectric.js.org/
  $(function () {
    $("select").selectric({
      nativeOnMobile: false,
    });
  });
</script>

<script is:inline>
  // https://kenwheeler.github.io/slick/
  $(".js-carousel").slick({
    slidesToShow: 3,
    slidesToScroll: 3,
    arrows: true,
    slidesToShow: 3,
    slidesToScroll: 1,
    responsive: [
      {
        breakpoint: 1024,
        settings: {
          centerPadding: "40px",
          slidesToShow: 2,
        },
      },
      {
        breakpoint: 640,
        settings: {
          arrows: false,
          centerMode: true,
          centerPadding: "40px",
          slidesToShow: 1,
        },
      },
    ],
  });
</script>

<script is:inline>
  $(".js-product-photos-big").slick({
    arrows: false,
    responsive: [
      {
        breakpoint: 2500,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          arrows: false,
          fade: true,
          asNavFor: ".js-product-photos-small",
        },
        breakpoint: 769,
        settings: {
          slidesToShow: 1,
          slidesToScroll: 1,
          dots: true,
          asNavFor: null,
          arrows: false,
        },
      },
    ],
  });
  $(".js-product-photos-small").slick({
    slidesToShow: 3,
    slidesToScroll: 1,
    asNavFor: ".js-product-photos-big",
    focusOnSelect: true,
    arrows: true,
    infinite: false,
    swipe: false
  });
</script>

<script is:inline>
  // https://www.lightgalleryjs.com/
  lightGallery(document.getElementById("lightgallery"), {
    speed: 500,
    selector: "._photo:not(.slick-cloned)",
    download: false,
    backgroundColor: "rgba(0,0,0,0.3)",
  });
</script>
